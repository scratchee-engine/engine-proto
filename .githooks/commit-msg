#!/usr/bin/env sh
# SEN-602 / SEN-628: commit-msg hook — gate closing-keyword + Linear ticket-ID combos
#
# Linear's GitHub integration auto-closes tickets when a commit on the default
# branch contains a closing magic word ("Fixes", "Closes", "Resolves", etc.)
# followed by a ticket ID. For multi-iteration umbrella tickets, every push
# would flip the ticket to Done even when the work isn't complete.
#
# Behaviour matrix (Edge ratified A + C1 on SEN-628):
#
#   | Context        | Closing-keyword + ticket-ID | SEN_602_CLOSE_INTENT_CONFIRMED | Result        |
#   | -------------- | --------------------------- | ------------------------------ | ------------- |
#   | any            | absent                      | (irrelevant)                   | silent allow  |
#   | interactive    | present                     | (irrelevant)                   | prompt y/N    |
#   | non-interactive| present                     | unset / not "1"                | HARD-FAIL     |
#   | non-interactive| present                     | "1"                            | allow + warn  |
#
# Pre-SEN-628 behaviour was "warn + allow" in non-interactive context, which
# let agent commits silently land wrong-ticket auto-closes (e.g. SEN-624
# false-close at parent@8fa8e65 — Jett incident, motivated this update).
#
# Escape hatch:
#   SEN_602_CLOSE_INTENT_CONFIRMED=1 git commit -m "Fixes SEN-XXX - ..."
# Use only when the commit truly closes the referenced ticket and you are
# scripting the commit (CI release flow, automated migration, etc.).
#
# Closing keywords cited from https://linear.app/docs/github

set -e

MSG_FILE="$1"
[ -z "$MSG_FILE" ] && exit 0

# Skip merge and squash commits (auto-generated messages)
case "$2" in
  merge|squash) exit 0 ;;
esac

# Read message, strip leading-# comment lines
MSG=$(grep -v '^#' "$MSG_FILE" 2>/dev/null || cat "$MSG_FILE")

# Linear-GitHub closing magic words (case-insensitive)
KEYWORDS='close|closes|closed|closing|fix|fixes|fixed|fixing|resolve|resolves|resolved|resolving|complete|completes|completed|completing|implements|implemented|implementing'

# Linear workspace ticket-ID prefixes
TICKET='(SEN|NIT|NYX)-[0-9]+'

# Match: keyword immediately followed by whitespace-or-colon then ticket ID.
# Conventional-commit subjects like "fix(scope): SEN-XXX -" don't match because
# "fix" is followed by "(", not whitespace/colon.
MATCHES=$(printf '%s\n' "$MSG" | grep -iEo "(^|[^A-Za-z])(${KEYWORDS})[[:space:]:]+${TICKET}" 2>/dev/null | sed -E 's/^[^A-Za-z]+//' || true)

[ -z "$MATCHES" ] && exit 0

# Warn — combo detected
printf '\n'
printf '⚠️  SEN-602: closing keyword + Linear ticket ID detected in commit message\n'
printf '\n'
printf 'Match(es):\n'
printf '%s\n' "$MATCHES" | sed 's/^/  /'
printf '\n'
printf 'Linear auto-closes the referenced ticket(s) when this commit reaches the default\n'
printf 'branch. For iteration commits on multi-step umbrella tickets, prefer a non-closing\n'
printf 'reference: "Refs SEN-XXX", "Part of SEN-XXX", or "Related to SEN-XXX".\n'
printf '\n'

# Non-interactive (CI, scripted, agent shells): HARD-FAIL by default (Edge
# A+C1 ruling on SEN-628). Pre-SEN-628 this path warned + allowed, which let
# wrong-ticket closes silently land (SEN-624 false-close at parent@8fa8e65).
#
# Escape hatch: set SEN_602_CLOSE_INTENT_CONFIRMED=1 in env. Use ONLY when:
#   1. You are scripting the commit (CI release flow, automated migration), AND
#   2. The closing keyword + ticket-ID combo is intentional — the commit
#      genuinely closes the referenced ticket.
#
# `[ ! -t 0 ]` detects pipe/redirect/agent contexts where prompting would hang
# or fail. /dev/tty may exist but not be openable in those contexts (macOS),
# so we don't try it.
if [ ! -t 0 ]; then
    if [ "${SEN_602_CLOSE_INTENT_CONFIRMED:-}" = "1" ]; then
        printf '(Non-interactive context with SEN_602_CLOSE_INTENT_CONFIRMED=1 — allowing commit.)\n'
        exit 0
    fi
    printf '✗ Commit aborted (Edge ratified A+C1 on SEN-628):\n'
    printf '  Non-interactive context cannot confirm closing intent at the prompt, and the\n'
    printf '  closing-keyword + ticket-ID combo would auto-close the referenced ticket via\n'
    printf '  the Linear-GitHub integration. Past wrong-ticket closes (SEN-624 false-close\n'
    printf '  at parent@8fa8e65) motivated the hard-fail.\n'
    printf '\n'
    printf '  Options:\n'
    printf '    1. Edit the commit message — use "Refs SEN-XXX" / "Part of SEN-XXX" /\n'
    printf '       "Related to SEN-XXX" instead. The conventional subject\n'
    printf '       "fix(scope): SEN-XXX - description" is also safe (does not auto-close).\n'
    printf '    2. If the commit genuinely closes the referenced ticket AND you are\n'
    printf '       scripting it intentionally, re-run with:\n'
    printf '          SEN_602_CLOSE_INTENT_CONFIRMED=1 git commit ...\n'
    printf '    3. Bypass the hook entirely with --no-verify (last resort; loses the guard).\n'
    exit 1
fi

# Interactive prompt (human shell, stdin is a TTY)
printf 'Does this commit fully complete the referenced ticket(s)? [y/N] '
ANSWER=""
read -r ANSWER || ANSWER=""

case "$ANSWER" in
    [yY]|[yY][eE][sS])
        printf '✓ Proceeding.\n'
        exit 0
        ;;
    *)
        printf '✗ Commit aborted. Edit your message (use Refs/Part of for iteration commits)\n'
        printf '  and re-commit, or pass --no-verify to bypass.\n'
        exit 1
        ;;
esac
