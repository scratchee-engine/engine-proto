#!/usr/bin/env bash
# Pre-commit hook: verify package.json version matches git tag (if on a tagged commit)

set -e

# Get current tag (if any)
CURRENT_TAG=$(git describe --exact-match --tags 2>/dev/null || echo "")

if [ -z "$CURRENT_TAG" ]; then
    # Not on a tagged commit, skip check
    exit 0
fi

# Extract version from tag (strip leading 'v')
TAG_VERSION="${CURRENT_TAG#v}"

# Extract version from package.json
PACKAGE_VERSION=$(jq -r '.version' package.json)

if [ "$TAG_VERSION" != "$PACKAGE_VERSION" ]; then
    echo "ERROR: package.json version ($PACKAGE_VERSION) doesn't match git tag ($CURRENT_TAG)"
    echo "Run: jq '.version = \"$TAG_VERSION\"' package.json > package.json.tmp && mv package.json.tmp package.json"
    exit 1
fi

echo "✓ package.json version ($PACKAGE_VERSION) matches tag ($CURRENT_TAG)"
exit 0
